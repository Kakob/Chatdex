# Frontend environment variables
# Same-origin requests; Vite proxies /api to the backend during development.
VITE_API_URL=/api
# Optional local backend override (never sent to the browser).
DEV_API_TARGET=http://localhost:3003
# For mobile passkeys, use a hostname + a certificate trusted by both devices.
# See README.md: Mobile login and shared projects.
# DEV_HOSTNAME=your-mac.local
# DEV_HTTPS_CERT=.certs/chatdex.pem
# DEV_HTTPS_KEY=.certs/chatdex-key.pem
